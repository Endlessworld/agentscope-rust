.idea
# Agent state: track the long-term memory only, ignore everything else.
.agentscope/*
!.agentscope/workspace/
.agentscope/workspace/*
!.agentscope/workspace/MEMORY.md
!.agentscope/workspace/memory/
# Per-crate/test-created state directories stay ignored.
/crates/**/.agentscope/
.openidea
.idea
agents
target
/MEMORY.md
/large_tool_results/
# Test artifacts: some harness tests build a default workspace rooted at the
# crate directory, which writes MEMORY.md + memory/<date>.md there.
/crates/*/MEMORY.md
/crates/*/memory/
